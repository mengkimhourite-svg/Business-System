APP_NAME="Smart Business System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sbs
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

# Server-to-server AI microservice (FastAPI). The AI provider key lives ONLY in ai/.env — never here, never in React.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_INTERNAL_KEY=
AI_SERVICE_TIMEOUT=20

# Bakong KHQR static payment (personal QR code — no API credentials needed)
KHQR_STATIC_QR_IMAGE_URL=/images/khqr-default.png
KHQR_MERCHANT_NAME="KIMHOUR MENG"
