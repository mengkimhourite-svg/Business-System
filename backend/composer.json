{
  "name": "sbs/backend",
  "description": "Smart Business System — Laravel 10 REST API",
  "type": "project",
  "require": {
    "php": "^8.2",
    "dedoc/scramble": "^0.13.42",
    "guzzlehttp/guzzle": "^7.2",
    "laravel/framework": "^10.10",
    "laravel/sanctum": "^3.3"
  },
  "require-dev": {
    "doctrine/dbal": "^3.10",
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.68",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^10.1"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/", "Database\\Factories\\": "database/factories/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"] },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "stable", "prefer-stable": true
}
