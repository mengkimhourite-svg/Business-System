# Smart Business System — AI microservice (FastAPI)
# Copy to .env — NEVER commit .env or expose these values to the browser.
APP_NAME="SBS AI Service"
APP_ENV=development
HOST=127.0.0.1
PORT=8001

# Shared secret Laravel sends in the X-Internal-Key header (server-to-server). Leave empty to disable in local dev.
INTERNAL_API_KEY=

# AI provider (OpenAI-compatible chat completions). If AI_API_KEY is empty the service
# falls back to deterministic, rule-based analysis so the platform keeps working.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
